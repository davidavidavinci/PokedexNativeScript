
<Page xmlns="http://schemas.nativescript.org/tns.xsd">

    <ActionBar title="Registrar Pokemon"
               backgroundColor="#D62828"
               color="white" />

    <ScrollView backgroundColor="#F5F5F5">

        <StackLayout padding="20" spacing="12">

            <Label text="Nuevo Pokemon"
                   fontSize="25"
                   fontWeight="bold"
                   color="#D62828" />

            <Label text="Complete los siguientes datos:"
                   fontSize="15"
                   color="#555555" />

            <Label text="Nombre del Pokemon:"
                   fontSize="17"
                   color="#010205"/>


            <TextField id="campoNombre"
                       hint="Ejemplo: Pikachu"
                       backgroundColor="black"
                       padding="12" />

            <Label text="Tipo del Pokemon:"
                   fontSize="17" 
                   color="#010205"/>

            <TextField id="campoTipo"
                       hint="Ejemplo: Electrico"
                       backgroundColor="black"
                       padding="12" />

            <Label text="Nivel del Pokemon:"
                   fontSize="17" 
                   color="#010205"/>


            <TextField id="campoNivel"
                       hint="Ingrese un nivel de 1 a 100"
                       keyboardType="number"
                       backgroundColor="black"
                       padding="12" />

            <Button text="Guardar Pokemon"
                    tap="guardarPokemon"
                    backgroundColor="#D62828"
                    color="white"
                    marginTop="15" />

            <Button text="Cancelar"
                    tap="cancelar"
                    backgroundColor="#777777"
                    color="white" />

        </StackLayout>

    </ScrollView>

</Page>
