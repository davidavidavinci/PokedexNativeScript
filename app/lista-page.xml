
<Page xmlns="http://schemas.nativescript.org/tns.xsd"
      navigatingTo="onNavigatingTo">

    <ActionBar title="Mi Pokedex"
               backgroundColor="#D62828"
               color="white" />

    <GridLayout rows="auto, auto, auto, *"
                padding="15"
                backgroundColor="#F5F5F5">

        <Label row="0"
               text="Mis Pokemon"
               fontSize="26"
               fontWeight="bold"
               color="#D62828"
               marginBottom="10" />

        <Label row="1"
               text="{{ total }}"
               fontSize="16"
               color="#333333"
               marginBottom="10" />

        <Button row="2"
                text="Registrar Pokemon"
                tap="abrirFormulario"
                backgroundColor="#D62828"
                color="white"
                marginBottom="15" />

        <ListView row="3"
                  items="{{ pokemones }}"
                  backgroundColor="#F5F5F5">

            <ListView.itemTemplate>

                <StackLayout padding="15"
                             margin="5"
                             backgroundColor="white">

                    <Label text="{{ nombre }}"
                           fontSize="21"
                           fontWeight="bold"
                           color="#D62828" />

                    <Label text="{{ detalle }}"
                           fontSize="16"
                           color="#333333" />

                </StackLayout>

            </ListView.itemTemplate>

        </ListView>

    </GridLayout>

</Page>
