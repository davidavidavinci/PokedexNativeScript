<Page xmlns="http://schemas.nativescript.org/tns.xsd"
      navigatingTo="onNavigatingTo">

    <ActionBar title="Mi Pokedex"
               backgroundColor="#D62828"
               color="white" />

    <GridLayout rows="auto, auto, *"
                padding="15"
                backgroundColor="#F5F5F5">

        <Label row="0"
               text="Mis Pokemon registrados"
               fontSize="22"
               fontWeight="bold"
               color="#222222"
               marginBottom="15" />

        <Button row="1"
                text="Agregar Pokemon"
                tap="abrirFormulario"
                backgroundColor="#D62828"
                color="white"
                marginBottom="15" />

        <ListView row="2"
                  items="{{ pokemones }}"
                  backgroundColor="#F5F5F5">

            <ListView.itemTemplate>

                <StackLayout padding="15"
                             margin="5"
                             backgroundColor="white">

                    <Label text="{{ nombre }}"
                           fontSize="20"
                           fontWeight="bold"
                           color="#D62828" />

                    <Label text="{{ tipo }}"
                           fontSize="16"
                           color="#333333" />

                    <Label text="{{ nivel }}"
                           fontSize="16"
                           color="#333333" />

                </StackLayout>

            </ListView.itemTemplate>

        </ListView>

    </GridLayout>

